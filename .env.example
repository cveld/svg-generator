# Option 1: Claude OAuth token (via: claude setup-token)
CLAUDE_OAUTH_TOKEN=sk-ant-oat01-...
USE_CLAUDE_CLI=false

# Option 2: Anthropic API key (via: platform.claude.com)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# USE_CLAUDE_CLI=false

# Option 3: spawn claude CLI directly
# USE_CLAUDE_CLI=true
# CLAUDE_CLI_PATH=claude   # override if not on PATH
